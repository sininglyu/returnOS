generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs live in prisma.config.ts (Migrate) and are
// passed to the driver adapter at runtime (lib/db.ts) — not here.
datasource db {
  provider = "postgresql"
}

// ---- NextAuth (Auth.js) adapter models ----
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  purchases Purchase[]
  syncRuns  SyncRun[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Domain models ----
model Purchase {
  id             String         @id @default(cuid())
  userId         String
  retailer       String
  itemName       String
  orderDate      DateTime
  price          Decimal?       @db.Decimal(10, 2)
  currency       String?        // ISO 4217, e.g. "USD"
  orderNumber    String?
  returnDeadline DateTime?      // null = "policy unknown" in UI
  status         PurchaseStatus @default(RETURNABLE)
  gmailMessageId String
  rawParseJson   Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@unique([userId, gmailMessageId]) // idempotency key when orderNumber is absent
  @@unique([userId, orderNumber]) // idempotency key when present - the real-
  // world order identity, stronger than one email about it (lib/purchases.ts
  // upsertPurchaseFromParse). Postgres treats multiple NULLs as distinct, so
  // orderNumber-less rows are unaffected and keep deduping on gmailMessageId.
  @@index([userId, returnDeadline]) // list sort + cron scan
}

model Reminder {
  id         String   @id @default(cuid())
  purchaseId String
  sentAt     DateTime @default(now())
  daysBefore Int

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, daysBefore]) // never send the same reminder twice
}

model SyncRun {
  id              String    @id @default(cuid())
  userId          String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  messagesScanned Int       @default(0)
  purchasesFound  Int       @default(0)
  error           String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum PurchaseStatus {
  RETURNABLE
  RETURNED
  EXPIRED
  KEEPING
}

// Fallback policy table (V1 checklist item 8), seeded with ~8 major
// retailers via prisma/seed.ts. Consulted by lib/parse.ts only when an
// email doesn't state its own return deadline. Unmatched retailer ->
// Purchase.returnDeadline stays null ("policy unknown" in the UI).
model RetailerPolicy {
  id               String   @id @default(cuid())
  retailer         String   @unique
  returnWindowDays Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
