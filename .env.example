# Copy to .env.local and fill in real values. Never commit .env.local.

# Database (Postgres). DATABASE_URL = pooled connection (app runtime, via
# lib/db.ts's driver adapter). DIRECT_URL = non-pooled connection (Migrate
# only, via prisma.config.ts).
DATABASE_URL=
DIRECT_URL=

# Auth.js v5 (Google provider)
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Tier 2 parsing (lib/openai.ts, gpt-5-nano via the Vercel AI SDK). Written
# as optional because sync still runs Tier 1-only without it - but Tier 1
# alone found 0/60 on a real inbox (see CLAUDE.md "Current status"), so in
# practice this is required for the app to find anything.
OPENAI_API_KEY=

# Outbound reminder email (choose one path)
RESEND_API_KEY=
# --- or SMTP ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Cron protection (shared secret checked by /api/cron/reminders)
CRON_SECRET=
